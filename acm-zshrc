# Detect color support
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
    *) color_prompt=no;;
esac

# Optional: force color
# force_color_prompt=yes

if [[ -n "$force_color_prompt" ]]; then
    if command -v tput >/dev/null && tput setaf 1 >/dev/null 2>&1; then
        color_prompt=yes
    else
        color_prompt=no
    fi
fi

# Prompt
if [[ "$color_prompt" == yes ]]; then
    PROMPT='%F{green}%n@%m%f:%F{blue}%1~%f$ '
else
    PROMPT='%n@%m:%1~$ '
fi

unset color_prompt force_color_prompt

# --- Set terminal title (like bash PS1 trick) ---
case "$TERM" in
    xterm*|rxvt*)
        precmd() {
            print -Pn "\e]0;%n@%m: %~\a"
        }
    ;;
esac

# --- Enable color support for ls / grep ---
# macOS uses BSD ls, not GNU ls → different flags

# If you installed coreutils via brew, prefer gls
if command -v gls >/dev/null; then
    alias ls='gls --color=auto'
else
    alias ls='ls -G'   # BSD/macOS color flag
fi

# grep coloring (works on macOS)
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'


